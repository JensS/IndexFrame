APP_NAME=Indexframe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://viewer.example.com
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-netcup-mysql-host
DB_PORT=3306
DB_DATABASE=your-netcup-database
DB_USERNAME=your-netcup-database-user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

EAGLE_PASSWORD_HASH=
EAGLE_WEBDAV_URL=https://cloud.example.com/remote.php/dav/spaces/your-space-id/
EAGLE_WEBDAV_USERNAME=
EAGLE_WEBDAV_PASSWORD=
EAGLE_WEBDAV_ROOT=/
EAGLE_WEBDAV_VERIFY_TLS=true
EAGLE_WRITES_ENABLED=false
EAGLE_WRITE_BACKUPS_ENABLED=true
EAGLE_WRITE_BACKUPS_KEEP_PER_ASSET=25
EAGLE_QUEUED_SYNC=true
EAGLE_SYNC_BATCH_SIZE=5
EAGLE_UPLOAD_MAX_KILOBYTES=122880
EAGLE_UPLOAD_REQUEST_MAX_KILOBYTES=122880
# Leave binaries empty unless their availability on hosting has been verified.
EAGLE_FFMPEG_PATH=
EAGLE_FFPROBE_PATH=
EAGLE_DERIVATIVE_WEBP_QUALITY=78
EAGLE_DERIVATIVE_GD_MAXIMUM_PIXELS=20000000

MAIL_MAILER=log
# For SMTP: set MAIL_MAILER=smtp, host, username, password and port 587/2525.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=viewer@example.com
MAIL_FROM_NAME=Indexframe
