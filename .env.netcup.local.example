# Local simulation only. Generate the key/hash with the commands in docs/netcup.md.
NETCUP_LOCAL_APP_KEY=
NETCUP_LOCAL_PASSWORD_HASH=
# Defaults use the bundled, read-only WebDAV fixture. To test your real OpenCloud,
# set these values locally. Writes remain disabled in the simulation.
# NETCUP_LOCAL_WEBDAV_URL=https://cloud.example.com/remote.php/dav/spaces/space-id/
# NETCUP_LOCAL_WEBDAV_USERNAME=
# NETCUP_LOCAL_WEBDAV_PASSWORD=
# NETCUP_LOCAL_WEBDAV_ROOT=/
